def distancia_km(lat1, lon1, lat2, lon2):
    """Distância entre dois pontos geográficos (Haversine)."""
    R = 6371
    dlat = math.radians(lat2 - lat1)
    dlon = math.radians(lon2 - lon1)
    a = (math.sin(dlat/2)**2 +
         math.cos(math.radians(lat1)) *
         math.cos(math.radians(lat2)) *
         math.sin(dlon/2)**2)
    return R * 2 * math.asin(math.sqrt(a))

def intensidade_mmi(magnitude, dist_km):
    """
    Estima intensidade MMI sentida em um ponto.
    Fórmula de atenuação simplificada (Bakun & Wentworth, adaptada).
    Retorna valor entre 0.0 e 12.0.
    """
    if dist_km < 1:
        dist_km = 1
    mmi = 2.085 * magnitude - 1.651 * math.log10(dist_km) - 0.5
    return round(max(0.0, min(12.0, mmi)), 1)

def buscar_api():
    """Tenta buscar epicentros na API USGS."""
    print("🌏 Buscando terremotos na API do USGS...")
    try:
        with urllib.request.urlopen(API_URL, timeout=20) as r:
            dados = json.loads(r.read().decode())
        eventos = dados["features"]
        print(f"   ✔ {len(eventos)} eventos encontrados via API.")
        epicentros = []
        for ev in eventos[:30]:
            p = ev["properties"]
            c = ev["geometry"]["coordinates"]
            nome = (p.get("place") or f"Epicentro_{len(epicentros)}")[:40]
            epicentros.append((nome, c[1], c[0], p.get("mag") or 6.0))
        return epicentros
    except Exception as e:
        print(f"   ✘ API inacessível ({e}). Usando dados históricos embutidos.")
        return None

def gerar_grafo():
    # 1) Epicentros
    epicentros = buscar_api() or FALLBACK_EPICENTROS
    epicentros = epicentros[:30]

    # 2) Vértices: 40 cidades + 30 epicentros = 70
    vertices = []
    for nome, lat, lon in CIDADES:
        vertices.append({"nome": nome, "lat": lat, "lon": lon, "peso": "0"})
    for nome, lat, lon, mag in epicentros:
        vertices.append({"nome": nome, "lat": lat, "lon": lon, "peso": str(round(mag, 1))})

    n = len(vertices)
    n_cidades = len(CIDADES)   # 40
    print(f"   Vértices montados: {n} (40 cidades + 30 epicentros)")

    # 3) Arestas
    adicionadas = set()
    arestas = []

    def add(u, v, peso):
        key = (min(u, v), max(u, v))
        if key not in adicionadas and peso >= 1.5:
            adicionadas.add(key)
            arestas.append((u, v, peso))

    # Epicentro ↔ Cidade (raio 2000 km, MMI ≥ 1.5)
    for j, ep in enumerate(epicentros):
        ep_idx = n_cidades + j
        ep_lat, ep_lon, ep_mag = ep[1], ep[2], ep[3]
        afetadas = []
        for i in range(n_cidades):
            d = distancia_km(vertices[i]["lat"], vertices[i]["lon"], ep_lat, ep_lon)
            if d <= 2000:
                mmi = intensidade_mmi(ep_mag, d)
                add(i, ep_idx, mmi)
                if mmi >= 2.0:
                    afetadas.append(i)

        # Cidade ↔ Cidade (mesma região, ambas afetadas, dist ≤ 500 km)
        for a in range(len(afetadas)):
            for b in range(a + 1, len(afetadas)):
                ci, cj = afetadas[a], afetadas[b]
                d_cc = distancia_km(
                    vertices[ci]["lat"], vertices[ci]["lon"],
                    vertices[cj]["lat"], vertices[cj]["lon"]
                )
                if d_cc <= 500:
                    mmi_i = intensidade_mmi(ep_mag, distancia_km(
                        vertices[ci]["lat"], vertices[ci]["lon"], ep_lat, ep_lon))
                    mmi_j = intensidade_mmi(ep_mag, distancia_km(
                        vertices[cj]["lat"], vertices[cj]["lon"], ep_lat, ep_lon))
                    add(ci, cj, round((mmi_i + mmi_j) / 2, 1))

    print(f"   Arestas geradas   : {len(arestas)}")
    if len(arestas) < 180:
        print("   ⚠ Abaixo de 180 — relaxando critério...")
        for j, ep in enumerate(epicentros):
            ep_idx = n_cidades + j
            ep_lat, ep_lon, ep_mag = ep[1], ep[2], ep[3]
            for i in range(n_cidades):
                d = distancia_km(vertices[i]["lat"], vertices[i]["lon"], ep_lat, ep_lon)
                if d <= 3000:
                    mmi = intensidade_mmi(ep_mag, d)
                    add(i, ep_idx, max(mmi, 0.5))
        print(f"   Arestas após relaxamento: {len(arestas)}")

    # 4) Gerar grafo.txt
    linhas = ["2", str(n)]
    for i, v in enumerate(vertices):
        linhas.append(f'{i} "{v["nome"]}" "{v["peso"]}"')
    linhas.append(str(len(arestas)))
    for u, v, p in arestas:
        linhas.append(f"{u} {v} {p}")

    conteudo = "\n".join(linhas)
    with open("grafo.txt", "w", encoding="utf-8") as f:
        f.write(conteudo)

    print("\n✅ grafo.txt gerado com sucesso!")
    print(f"   Tipo      : 2 (não orientado, peso = intensidade MMI)")
    print(f"   Vértices  : {n}  (mínimo exigido: 70  ✔)" if n >= 70
          else f"   Vértices  : {n}  ⚠ abaixo de 70")
    print(f"   Arestas   : {len(arestas)}  (mínimo exigido: 180  ✔)" if len(arestas) >= 180
          else f"   Arestas   : {len(arestas)}  ⚠ abaixo de 180")
    print("\n📄 Primeiras 10 linhas do arquivo:")
    for l in linhas[:10]:
        print("   ", l)
    print("   ...")

    return n, len(arestas)

if __name__ == "__main__":
    gerar_grafo()
